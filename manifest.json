{
  "manifest_version": 3,
  "name": "Ayumin Gallery",
  "version": "1.0",
  "description": "Halaman New Tab premium dengan Glassmorphism, Mini Gallery, Clock, History, dan Bookmarks.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "bookmarks",
    "history",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*", "photos.json"],
      "matches": ["<all_urls>"]
    }
  ]
}